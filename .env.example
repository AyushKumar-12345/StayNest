# ===================================================================
# StayNest Environment Configuration Template
# ===================================================================
# Copy this file to '.env' and provide your actual credentials.
# NEVER commit your real '.env' file or production secrets to Git.

# Server Port and Environment
PORT=8080
NODE_ENV=development

# Session Encryption Secret (Required)
# Use a random, high-entropy string (e.g., generated with `openssl rand -hex 32`)
SECRET=your_secure_session_secret_key_here

# Database Configuration (Provide ATLASDB_URL or local MONGO_URL)
# For remote MongoDB Atlas (Production & Cloud Dev):
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/staynest?retryWrites=true&w=majority

# For local MongoDB container (Docker Compose):
MONGO_URL=mongodb://localhost:27017/staynest

# Default Owner ObjectId (Required for running 'node init/index.js' database seeding)
# Must be a valid 24-character hexadecimal MongoDB ObjectId of an existing registered user
DEFAULT_OWNER=64b7f1a2c3d4e5f6a7b8c9d0

# Cloudinary Storage (Required for property photos & avatar uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Required for checkout & booking verification)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Gemini Generative AI (Required for description drafting & AI concierge)
GEMINI_API_KEY=your_google_gemini_api_key
