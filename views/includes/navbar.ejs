<style>
  .navbar {
    background: rgba(255, 255, 255, 0.96) !important;
    backdrop-filter: blur(14px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .navbar-brand {
    font-size: 2rem;
    color: #ff385c !important;
    transition: transform 0.3s ease;
  }

  .navbar-brand:hover {
    transform: rotate(-10deg) scale(1.08);
  }

  .nav-link {
    color: #222 !important;
    font-weight: 600;
    transition: all 0.25s ease;
    border-radius: 10px;
    padding: 0.55rem 0.9rem !important;
  }

  .nav-link:hover {
    color: #ff385c !important;
    background: rgba(255, 56, 92, 0.08);
  }

  .search-form {
    max-width: 420px;
    width: 100%;
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-inp {
    border-radius: 999px !important;
    border: 1px solid #e2e8f0 !important;
    padding: 0.62rem 3.4rem 0.62rem 1.25rem !important;
    font-size: 0.9rem !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04) !important;
    transition: all 0.25s ease;
    width: 100%;
  }

  .search-inp:focus {
    border-color: #ff385c !important;
    box-shadow: 0 4px 18px rgba(255, 56, 92, 0.16) !important;
  }

  .search-btn {
    position: absolute;
    right: 5px;
    background: #ff385c !important;
    color: #ffffff !important;
    border: none !important;
    border-radius: 50% !important;
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 0.85rem !important;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .search-btn:hover {
    background: #e61e4d !important;
    transform: scale(1.06);
  }

  .nav-profile-img {
    width: 26px;
    height: 26px;
    object-fit: cover;
    border-radius: 50%;
    border: 1.5px solid #ff385c;
    display: inline-block;
  }

  .nav-profile-initial {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff385c 0%, #e11d48 100%);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    border: 1px solid #ffffff;
    box-shadow: 0 2px 6px rgba(255, 56, 92, 0.35);
    line-height: 1;
  }

  @media (max-width: 991px) {
    .search-form {
      margin: 1rem 0;
    }
  }
</style>

<nav class="navbar navbar-expand-lg sticky-top border-bottom">
  <div class="container">
    <a class="navbar-brand" href="/">
      <i class="fa-regular fa-compass"></i>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" href="/listings">Explore</a>
        </li>
      </ul>

      <% if (typeof pageUrl !== 'undefined' && pageUrl && pageUrl.startsWith("/listings") && pageUrl !== "/listings/new") { %>
      <form class="search-form mx-lg-auto my-3 my-lg-0" action="/listings" method="GET" autocomplete="off">
        <input class="form-control search-inp" type="search" name="search" placeholder="Search destinations, stays..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" autocomplete="off" spellcheck="false">
        <button class="btn search-btn" type="submit" aria-label="Search">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
      <% } else { %>
      <div class="mx-lg-auto"></div>
      <% } %>

      <ul class="navbar-nav ms-lg-4 align-items-lg-center">
        <% if (typeof currUser !== 'undefined' && currUser) { %>
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center gap-2" href="/profile">
            <% 
              const hasCustomImg = currUser.profileImage?.url && 
                                   !currUser.profileImage.url.includes("placehold.co") && 
                                   !currUser.profileImage.url.includes("placeholder");
              const name = currUser.username || (currUser.email ? currUser.email.split("@")[0] : "");
              const initial = name ? name.trim().charAt(0).toUpperCase() : "U";
            %>
            <% if (hasCustomImg) { %>
              <img src="<%= currUser.profileImage.url %>" class="nav-profile-img" alt="<%= name %>">
            <% } else { %>
              <span class="nav-profile-initial"><%= initial %></span>
            <% } %>
            <span>Profile</span>
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/wishlist">
            <i class="fa-solid fa-heart me-1 text-danger"></i>
            Wishlist
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/orders/myorders">
            <i class="fa-solid fa-bag-shopping me-1 text-danger"></i>
            My Orders
          </a>
        </li>
        <% } %>

        <li class="nav-item">
          <a class="nav-link" href="/listings/new">StayNest your home</a>
        </li>

        <% if (typeof currUser === 'undefined' || !currUser) { %>
        <li class="nav-item">
          <a class="nav-link" href="/signup"><strong>Sign Up</strong></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/login"><strong>Log In</strong></a>
        </li>
        <% } else { %>
        <li class="nav-item">
          <a class="nav-link" href="/logout"><strong>Log Out</strong></a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>