<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-5">
  <div class="col-lg-8 col-md-10">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-4 p-md-5">
        <h2 class="fw-bold mb-4 text-center">
          <i class="fa-solid fa-pen-to-square text-danger me-2"></i>Edit Listing
        </h2>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data" class="needs-validation" novalidate id="edit-listing-form">
          <div class="mb-4">
            <label for="edit-title" class="form-label fw-semibold">Title</label>
            <input id="edit-title" name="listing[title]" type="text" class="form-control" value="<%= listing.title %>" required>
            <div class="invalid-feedback">Please enter a title.</div>
          </div>

          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
              <label for="edit-description" class="form-label fw-semibold mb-0">Description</label>
              <div class="d-flex align-items-center gap-2">
                <select id="edit-ai-vibe" class="form-select form-select-sm border-danger-subtle text-danger" style="font-size: 0.8rem; width: auto; border-radius: 999px;">
                  <option value="warm, inviting, and cozy">✨ Cozy & Welcoming</option>
                  <option value="luxurious, high-end, and sophisticated">✨ Luxury & Elegant</option>
                  <option value="vibrant, energetic, and modern">✨ Vibrant & Modern</option>
                  <option value="scenic, peaceful, and nature-focused">✨ Nature & Peaceful</option>
                </select>
                <button type="button" id="btn-edit-ai-generate" class="btn btn-sm btn-outline-danger rounded-pill fw-bold shadow-xs px-3">
                  <i class="fa-solid fa-wand-magic-sparkles me-1"></i>
                  <span id="btn-edit-ai-text">Enhance with AI</span>
                </button>
              </div>
            </div>

            <textarea id="edit-description" name="listing[description]" class="form-control" rows="5" required><%= listing.description %></textarea>
            <div class="invalid-feedback">Please provide a description.</div>

            <div id="edit-ai-status-msg" class="mt-2 small d-none"></div>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold d-block">Current Image</label>
            <img src="<%= originalImageUrl || listing.image.url %>" class="img-fluid rounded-4 shadow-sm" style="max-height: 250px; object-fit: cover;" alt="Listing Image">
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Upload New Image</label>
            <input name="listing[image]" type="file" class="form-control" accept="image/*">
          </div>

          <div class="row">
            <div class="col-md-6 mb-4">
              <label class="form-label fw-semibold">Price (₹)</label>
              <input name="listing[price]" type="number" min="0" class="form-control" value="<%= listing.price %>" required>
              <div class="invalid-feedback">Please enter a valid price.</div>
            </div>

            <div class="col-md-6 mb-4">
              <label for="edit-category" class="form-label fw-semibold">Category</label>
              <select id="edit-category" name="listing[category]" class="form-select" required>
                <% [
                  "Trending",
                  "Rooms",
                  "Cities",
                  "Mountains",
                  "Castles",
                  "Pools",
                  "Camping",
                  "Farms",
                  "Arctic",
                  "Domes",
                  "Boats"
                ].forEach(category => { %>
                  <option value="<%= category %>" <%= listing.category === category ? "selected" : "" %>><%= category %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-4">
              <label for="edit-location" class="form-label fw-semibold">Location</label>
              <input id="edit-location" name="listing[location]" type="text" class="form-control" value="<%= listing.location %>" required>
              <div class="invalid-feedback">Please enter a location.</div>
            </div>

            <div class="col-md-6 mb-4">
              <label for="edit-country" class="form-label fw-semibold">Country</label>
              <input id="edit-country" name="listing[country]" type="text" class="form-control" value="<%= listing.country %>" required>
              <div class="invalid-feedback">Please enter a country.</div>
            </div>
          </div>

          <div class="d-grid">
            <button class="btn btn-danger btn-lg rounded-3 fw-bold">
              <i class="fa-solid fa-floppy-disk me-2"></i>Update Listing
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const aiBtn = document.getElementById("btn-edit-ai-generate");
    const aiBtnText = document.getElementById("btn-edit-ai-text");
    const titleInput = document.getElementById("edit-title");
    const locationInput = document.getElementById("edit-location");
    const countryInput = document.getElementById("edit-country");
    const categorySelect = document.getElementById("edit-category");
    const vibeSelect = document.getElementById("edit-ai-vibe");
    const descriptionTextarea = document.getElementById("edit-description");
    const statusMsg = document.getElementById("edit-ai-status-msg");

    if (aiBtn && descriptionTextarea) {
      aiBtn.addEventListener("click", async () => {
        const title = titleInput ? titleInput.value.trim() : "";
        const location = locationInput ? locationInput.value.trim() : "";
        const country = countryInput ? countryInput.value.trim() : "";
        const category = categorySelect ? categorySelect.value : "";
        const vibe = vibeSelect ? vibeSelect.value : "";

        if (!title || !location) {
          statusMsg.className = "alert alert-warning py-2 px-3 mt-2 rounded-3 small d-flex align-items-center gap-2";
          statusMsg.innerHTML = '<i class="fa-solid fa-circle-info text-warning"></i><span>Please ensure <strong>Title</strong> and <strong>Location</strong> are filled before enhancing.</span>';
          statusMsg.classList.remove("d-none");
          return;
        }

        aiBtn.disabled = true;
        const originalContent = aiBtnText.innerHTML;
        aiBtnText.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Enhancing with AI...';

        statusMsg.className = "alert alert-info py-2 px-3 mt-2 rounded-3 small d-flex align-items-center gap-2";
        statusMsg.innerHTML = '<i class="fa-solid fa-sparkles fa-spin text-info"></i><span>StayNest AI is crafting a refined description...</span>';
        statusMsg.classList.remove("d-none");

        try {
          const res = await fetch("/api/ai/generate-description", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              title,
              location,
              country,
              category: category || "Vacation Home",
              vibe
            })
          });

          const data = await res.json();

          if (data.success && data.description) {
            descriptionTextarea.value = data.description;
            descriptionTextarea.classList.remove("is-invalid");

            statusMsg.className = "alert alert-success py-2 px-3 mt-2 rounded-3 small d-flex align-items-center gap-2";
            statusMsg.innerHTML = '<i class="fa-solid fa-check-circle text-success"></i><span><strong>AI description enhanced!</strong> You can review or tweak it before saving changes.</span>';

            aiBtnText.innerHTML = '<i class="fa-solid fa-rotate me-1"></i> Regenerate with AI';
          } else {
            statusMsg.className = "alert alert-danger py-2 px-3 mt-2 rounded-3 small d-flex align-items-center gap-2";
            statusMsg.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-danger"></i><span>${data.message || "Failed to generate description. Please try again."}</span>`;
            aiBtnText.innerHTML = originalContent;
          }
        } catch (err) {
          console.error("AI Generation Client Error:", err);
          statusMsg.className = "alert alert-danger py-2 px-3 mt-2 rounded-3 small d-flex align-items-center gap-2";
          statusMsg.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-danger"></i><span>Network error connecting to AI assistant. Please try again.</span>';
          aiBtnText.innerHTML = originalContent;
        } finally {
          aiBtn.disabled = false;
        }
      });
    }
  });
</script>