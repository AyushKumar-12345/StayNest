<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/material_red.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<style>
  .booking-widget-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.08);
    transition: box-shadow 0.25s ease;
  }

  .booking-widget-card:hover {
    box-shadow: 0 20px 48px rgba(255, 56, 92, 0.1);
  }

  .staynest-price-tag {
    font-size: 2rem;
    font-weight: 800;
    color: #ff385c;
    letter-spacing: -0.5px;
  }

  .staynest-badge-pill {
    background: linear-gradient(135deg, rgba(255, 56, 92, 0.12), rgba(225, 29, 72, 0.18));
    color: #e11d48;
    border: 1px solid rgba(255, 56, 92, 0.28);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .date-picker-box {
    border: 2px solid #e2e8f0;
    border-radius: 1rem;
    overflow: hidden;
    background: #ffffff;
    display: flex;
    transition: all 0.2s ease;
  }

  .date-picker-box:hover,
  .date-picker-box:focus-within {
    border-color: #ff385c;
    box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.12);
  }

  .date-segment {
    padding: 0.8rem 1.1rem;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .date-segment:hover {
    background: #fff5f6;
  }

  .date-segment label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ff385c;
    margin-bottom: 2px;
    display: block;
    cursor: pointer;
    text-transform: uppercase;
  }

  .date-input-clean {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    padding: 0 !important;
    font-weight: 600;
    font-size: 0.95rem;
    color: #1e293b;
    cursor: pointer;
    width: 100%;
  }

  .date-divider {
    width: 2px;
    background-color: #e2e8f0;
  }

  .book-action-btn {
    background: linear-gradient(135deg, #ff385c 0%, #e61e4d 50%, #d70466 100%) !important;
    color: #ffffff !important;
    border: none !important;
    padding: 0.95rem 1.5rem !important;
    border-radius: 1rem !important;
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.02em;
    width: 100%;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(255, 56, 92, 0.35);
    transition: all 0.25s cubic-bezier(0.2, 0, 0, 1) !important;
  }

  .book-action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(255, 56, 92, 0.5) !important;
    color: #ffffff !important;
  }

  .book-action-btn:active {
    transform: translateY(0);
  }

  .invoice-card {
    background: #fff9fa;
    border: 1.5px dashed rgba(255, 56, 92, 0.35);
    border-radius: 1rem;
    padding: 1.1rem 1.25rem;
  }

  @media (max-width: 576px) {
    .date-picker-box {
      flex-direction: column;
    }
    .date-divider {
      width: 100%;
      height: 2px;
    }
  }
</style>

<div class="row justify-content-center my-5">
  <div class="col-lg-8 col-md-10">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
      <img src="<%= listing.image?.url || 'https://placehold.co/900x600?text=StayNest' %>" class="card-img-top w-100" alt="<%= listing.title %>" style="max-height: 480px; object-fit: cover;">
      <div class="card-body p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h2 class="fw-bold mb-0"><%= listing.title %></h2>
          <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold"><%= listing.category %></span>
        </div>

        <p class="text-muted mb-4">
          <i class="fa-solid fa-location-dot me-2 text-danger"></i><%= listing.location %>, <%= listing.country %>
        </p>

        <div class="bg-light rounded-3 p-3 mb-4">
          <p class="text-secondary small mb-1">Hosted by</p>
          <p class="fw-semibold mb-0">
            <i class="fa-solid fa-circle-user me-2"></i><%= listing.owner?.email?.split("@")[0] || "System Administrator" %>
          </p>
        </div>

        <h5 class="fw-bold mb-3">About this space</h5>
        <p class="text-secondary mb-4 lh-base" style="white-space: pre-line;"><%= listing.description %></p>

        <div class="border-top pt-4">
          <% const isOwner = typeof currUser !== 'undefined' && currUser && listing.owner && listing.owner._id.toString() === currUser._id.toString(); %>

          <div class="booking-widget-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
              <div>
                <span class="staynest-price-tag">₹<%= listing.price.toLocaleString("en-IN") %></span>
                <span class="text-muted fw-semibold fs-6">/ night</span>
              </div>
              <span class="staynest-badge-pill">
                <i class="fa-solid fa-shield-halved"></i>
                Best Price Guarantee
              </span>
            </div>

            <% if (typeof currUser !== 'undefined' && currUser && !isOwner) { %>
            <div class="date-picker-box mb-4">
              <div class="date-segment flex-fill" onclick="document.getElementById('checkin-date').click()">
                <label><i class="fa-regular fa-calendar me-1"></i>CHECK-IN</label>
                <input type="text" id="checkin-date" class="date-input-clean" placeholder="Add date" readonly>
                <input type="hidden" id="checkIn">
              </div>
              <div class="date-divider"></div>
              <div class="date-segment flex-fill" onclick="document.getElementById('checkout-date').click()">
                <label><i class="fa-regular fa-calendar-check me-1"></i>CHECK-OUT</label>
                <input type="text" id="checkout-date" class="date-input-clean" placeholder="Add date" readonly>
                <input type="hidden" id="checkOut">
              </div>
            </div>

            <div id="invoice-box" class="invoice-card mb-4 d-none">
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Nights selected</span>
                <span class="fw-bold text-dark" id="breakdown-nights">0</span>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">₹<%= listing.price.toLocaleString("en-IN") %> × <span id="calc-nights">0</span> nights</span>
                <span class="fw-semibold text-dark">₹<span id="base-price">0</span></span>
              </div>
              <hr class="my-2 border-danger opacity-25">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold fs-6 text-dark">Total Payable</span>
                <span class="fw-extrabold text-danger fs-4">₹<span id="total-price">0</span></span>
              </div>
            </div>

            <button id="book-now-btn" 
                    type="button"
                    class="btn book-action-btn" 
                    data-listing-id="<%= listing._id %>"
                    data-listing-price="<%= listing.price %>"
                    data-razorpay-key="<%= typeof razorpayKeyId !== 'undefined' ? razorpayKeyId : '' %>">
              <i class="fa-solid fa-bolt me-2"></i>Select Booking Dates
            </button>
            <% } else if (typeof currUser === 'undefined' || !currUser) { %>
            <a href="/login" class="btn book-action-btn text-center text-decoration-none">
              <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Log In to Reserve Stay
            </a>
            <% } else { %>
            <div class="alert alert-light border border-danger-subtle rounded-3 mb-0 d-flex align-items-center gap-2 text-danger fw-semibold">
              <i class="fa-solid fa-house-user fs-5"></i>
              <span>You are the host of this property.</span>
            </div>
            <% } %>
          </div>
        </div>

        <div class="border-top pt-4 mt-4">
          <h5 class="fw-bold mb-3">
            <i class="fa-solid fa-map-location-dot me-2 text-danger"></i>Where you'll be
          </h5>
          <p class="text-secondary mb-3"><%= listing.location %>, <%= listing.country %></p>
          <div id="map" 
               class="rounded-4 shadow-sm" 
               style="height: 380px; width: 100%; z-index: 1;" 
               data-lat="<%= (listing.coordinates && listing.coordinates.lat) ? listing.coordinates.lat : 28.6139 %>" 
               data-lng="<%= (listing.coordinates && listing.coordinates.lng) ? listing.coordinates.lng : 77.2090 %>" 
               data-title="<%= listing.title %>" 
               data-location="<%= listing.location %>, <%= listing.country %>">
          </div>
        </div>

        <% if (typeof currUser !== 'undefined' && currUser && isOwner) { %>
        <div class="d-flex gap-3 border-top pt-4 mt-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-3 fw-bold px-4">
            <i class="fa-solid fa-pen-to-square me-2"></i>Edit Listing
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-outline-danger rounded-3 fw-bold px-4">
              <i class="fa-solid fa-trash me-2"></i>Delete Listing
            </button>
          </form>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5">
  <% if (typeof currUser !== 'undefined' && currUser) { %>
  <h4 class="fw-bold mb-4">Leave a Review</h4>
  <form method="POST" action="/listings/<%= listing._id %>/reviews" class="needs-validation mb-4" novalidate>
    <div class="mb-3">
      <label class="form-label fw-semibold">Rating</label>
      <fieldset class="starability-slot">
        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
        
        <input type="radio" id="rate1" name="review[rating]" value="1">
        <label for="rate1">1 star</label>
        
        <input type="radio" id="rate2" name="review[rating]" value="2">
        <label for="rate2">2 stars</label>
        
        <input type="radio" id="rate3" name="review[rating]" value="3">
        <label for="rate3">3 stars</label>
        
        <input type="radio" id="rate4" name="review[rating]" value="4">
        <label for="rate4">4 stars</label>
        
        <input type="radio" id="rate5" name="review[rating]" value="5">
        <label for="rate5">5 stars</label>
      </fieldset>
    </div>

    <div class="mb-4">
      <label class="form-label fw-semibold">Comment</label>
      <textarea name="review[comment]" rows="4" class="form-control rounded-3" placeholder="Share your experience..." required></textarea>
      <div class="invalid-feedback">Please write a comment.</div>
    </div>

    <button class="btn btn-danger rounded-3 fw-bold px-4">Submit Review</button>
  </form>
  <hr>
  <% } %>

  <h4 class="fw-bold mb-4">Reviews</h4>
  <% if (listing.reviews?.length) { %>
  <div class="row g-4">
    <% listing.reviews.forEach(review => { %>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-3">
        <div class="d-flex align-items-center mb-3">
          <img src="<%= review.author?.profileImage?.url || 'https://placehold.co/60x60?text=User' %>" class="rounded-circle me-3" style="width: 55px; height: 55px; object-fit: cover;">
          <div>
            <h6 class="fw-bold mb-1"><%= review.author?.email?.split("@")[0] || "User" %></h6>
            <div class="text-warning">
              <% for (let i = 1; i <= 5; i++) { %>
              <i class="<%= i <= review.rating ? 'fa-solid fa-star' : 'fa-regular fa-star' %>"></i>
              <% } %>
            </div>
          </div>
        </div>
        <p class="text-secondary"><%= review.comment %></p>
        <% if (typeof currUser !== 'undefined' && currUser && review.author && review.author._id.toString() === currUser._id.toString()) { %>
        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
          <button class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <p class="text-secondary">No reviews yet.</p>
  <% } %>
</div>

<div id="booked-ranges-data" data-ranges='<%- JSON.stringify(typeof bookedDateRanges !== "undefined" ? bookedDateRanges : []) %>'></div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", async function () {
    const checkInInput = document.getElementById("checkIn");
    const checkOutInput = document.getElementById("checkOut");
    const checkinDateEl = document.getElementById("checkin-date");
    const checkoutDateEl = document.getElementById("checkout-date");
    const bookBtn = document.getElementById("book-now-btn");
    const bookedRangesEl = document.getElementById("booked-ranges-data");
    const disabledRanges = bookedRangesEl ? JSON.parse(bookedRangesEl.getAttribute("data-ranges") || "[]") : [];

    let datesReady = false;

    function calculateBooking() {
      if (!checkInInput.value || !checkOutInput.value || !bookBtn) return;
      const start = new Date(checkInInput.value);
      const end = new Date(checkOutInput.value);
      const listingPrice = Number(bookBtn.dataset.listingPrice);

      if (end > start) {
        const nights = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
        const total = listingPrice * nights;

        document.getElementById("breakdown-nights").innerText = nights;
        document.getElementById("calc-nights").innerText = nights;
        document.getElementById("base-price").innerText = total.toLocaleString("en-IN");
        document.getElementById("total-price").innerText = total.toLocaleString("en-IN");
        document.getElementById("invoice-box").classList.remove("d-none");

        datesReady = true;
        bookBtn.innerHTML = '<i class="fa-solid fa-bolt me-2"></i>Reserve Now & Pay';
      } else {
        datesReady = false;
        if (bookBtn) {
          bookBtn.innerHTML = '<i class="fa-solid fa-bolt me-2"></i>Select Booking Dates';
        }
        document.getElementById("invoice-box").classList.add("d-none");
      }
    }

    let checkinPicker = null;
    let checkoutPicker = null;

    if (typeof flatpickr !== "undefined" && checkinDateEl && checkoutDateEl) {
      checkinPicker = flatpickr("#checkin-date", {
        minDate: "today",
        dateFormat: "Y-m-d",
        disable: disabledRanges,
        onChange: function(selectedDates) {
          if (selectedDates.length) {
            const localDate = new Date(selectedDates[0].getTime() - selectedDates[0].getTimezoneOffset() * 60000);
            checkInInput.value = localDate.toISOString().split('T')[0];
            
            const nextDay = new Date(selectedDates[0]);
            nextDay.setDate(nextDay.getDate() + 1);

            if (checkoutPicker) {
              checkoutPicker.set("minDate", nextDay);
              checkoutPicker.open();
            }
            calculateBooking();
          }
        }
      });

      checkoutPicker = flatpickr("#checkout-date", {
        minDate: "today",
        dateFormat: "Y-m-d",
        disable: disabledRanges,
        onChange: function(selectedDates) {
          if (selectedDates.length) {
            const localDate = new Date(selectedDates[0].getTime() - selectedDates[0].getTimezoneOffset() * 60000);
            checkOutInput.value = localDate.toISOString().split('T')[0];
            calculateBooking();
          }
        }
      });
    }

    if (bookBtn) {
      bookBtn.addEventListener("click", async () => {
        if (!datesReady) {
          if (checkinPicker) checkinPicker.open();
          return;
        }

        const listingId = bookBtn.dataset.listingId;
        bookBtn.disabled = true;
        bookBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Securing reservation...';
        
        try {
          const response = await fetch(`/orders/create/${listingId}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              checkIn: checkInInput.value,
              checkOut: checkOutInput.value,
              nights: document.getElementById("breakdown-nights").innerText
            })
          });

          const data = await response.json();
          if (!data.success) {
            alert(data.error);
            bookBtn.disabled = false;
            calculateBooking();
            return;
          }

          const options = {
            key: bookBtn.dataset.razorpayKey,
            amount: data.order.amount,
            currency: "INR",
            name: "StayNest",
            description: "Booking Accommodation Payment",
            order_id: data.order.id,
            handler: async function(response) {
              const verify = await fetch("/orders/verify", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(response)
              });
              const result = await verify.json();
              if (result.status === "success") {
                window.location.href = "/orders/myorders";
              } else {
                alert("Payment verification failed.");
                window.location.reload();
              }
            },
            modal: {
              ondismiss: function() {
                bookBtn.disabled = false;
                calculateBooking();
              }
            }
          };

          const razorpayInstance = new Razorpay(options);
          razorpayInstance.open();
        } catch (err) {
          console.error(err);
          alert("An error occurred during order generation.");
          bookBtn.disabled = false;
          calculateBooking();
        }
      });
    }

    const mapElement = document.getElementById("map");
    if (mapElement && typeof L !== "undefined") {
      const defaultLat = parseFloat(mapElement.getAttribute("data-lat")) || 28.6139;
      const defaultLng = parseFloat(mapElement.getAttribute("data-lng")) || 77.2090;
      const title = mapElement.getAttribute("data-title") || "Stay";
      const listingLocation = mapElement.getAttribute("data-location") || "";

      let map = L.map("map").setView([defaultLat, defaultLng], 12);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);

      let marker = L.marker([defaultLat, defaultLng]).addTo(map);
      marker.bindPopup(`<b>${title}</b><br>${listingLocation}`).openPopup();

      try {
        const geoRes = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(listingLocation)}`);
        const geoData = await geoRes.json();
        if (geoData && geoData.length > 0) {
          const lat = parseFloat(geoData[0].lat);
          const lon = parseFloat(geoData[0].lon);
          map.setView([lat, lon], 12);
          marker.setLatLng([lat, lon]);
        }
      } catch (err) {
        console.error(err);
      }
    }
  });
</script>