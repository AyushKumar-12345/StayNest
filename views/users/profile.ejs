<% layout("/layouts/boilerplate") %>

<style>
  .profile-card {
    background: #ffffff;
    border: 1px solid #f1f5f9;
    border-radius: 1.75rem;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
    overflow: hidden;
    position: relative;
  }

  .profile-banner {
    height: 140px;
    background: linear-gradient(135deg, #ff385c 0%, #e11d48 55%, #9f1239 100%);
    position: relative;
    overflow: hidden;
  }

  .profile-banner::after {
    content: "";
    position: absolute;
    top: -50%;
    right: -20%;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .avatar-wrapper {
    position: relative;
    width: 130px;
    height: 130px;
    margin: -65px auto 1.25rem;
  }

  .avatar-img {
    width: 130px;
    height: 130px;
    object-fit: cover;
    border-radius: 50%;
    border: 4.5px solid #ffffff;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.15);
    background: #ffffff;
  }

  .avatar-placeholder {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    border: 4.5px solid #ffffff;
    box-shadow: 0 10px 28px rgba(255, 56, 92, 0.22);
    background: linear-gradient(135deg, #ffe4e6 0%, #fecdd3 50%, #fda4af 100%);
    color: #e11d48;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -1px;
  }

  .avatar-badge-check {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: #10b981;
    color: #ffffff;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 3px solid #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    box-shadow: 0 4px 10px rgba(16, 185, 129, 0.35);
  }

  .guest-badge {
    background: linear-gradient(135deg, rgba(255, 56, 92, 0.08), rgba(225, 29, 72, 0.14));
    color: #e11d48;
    border: 1px solid rgba(255, 56, 92, 0.25);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 2px 8px rgba(255, 56, 92, 0.08);
  }

  .profile-stats {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 1rem;
    padding: 0.85rem 1rem;
    display: flex;
    justify-content: space-around;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .profile-stat-item {
    text-align: center;
  }

  .profile-stat-item .val {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
  }

  .profile-stat-item .lbl {
    font-size: 0.7rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  .profile-stat-divider {
    width: 1px;
    height: 32px;
    background: #e2e8f0;
  }

  .upload-box {
    background: #ffffff;
    border: 1.5px dashed #cbd5e1;
    border-radius: 1.2rem;
    padding: 1.35rem;
    transition: all 0.25s ease;
  }

  .upload-box:hover {
    border-color: #ff385c;
    background: #fffafa;
    box-shadow: 0 6px 20px rgba(255, 56, 92, 0.06);
  }

  .file-input-clean {
    border-radius: 0.75rem !important;
    border: 1.5px solid #e2e8f0 !important;
    padding: 0.6rem 0.9rem !important;
    background: #ffffff !important;
    font-size: 0.85rem;
    color: #475569;
    transition: border-color 0.2s ease;
  }

  .file-input-clean:focus {
    border-color: #ff385c !important;
    box-shadow: 0 0 0 3px rgba(255, 56, 92, 0.12) !important;
  }

  .btn-staynest-upload {
    background: linear-gradient(135deg, #ff385c, #e11d48);
    color: #ffffff !important;
    border: none;
    border-radius: 0.75rem;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 0.65rem 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    transition: all 0.2s ease;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(255, 56, 92, 0.25);
  }

  .btn-staynest-upload:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 56, 92, 0.4);
  }

  .btn-staynest-bookings {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: #ffffff !important;
    border: none;
    border-radius: 1rem;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.95rem 1.5rem;
    transition: all 0.25s ease;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.15);
  }

  .btn-staynest-bookings:hover {
    background: linear-gradient(135deg, #ff385c, #e11d48);
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(255, 56, 92, 0.38);
    color: #ffffff !important;
  }
</style>

<div class="row justify-content-center my-5">
  <div class="col-lg-5 col-md-7 col-sm-10">
    <div class="profile-card">
      <div class="profile-banner d-flex justify-content-between align-items-center p-3 px-4">
        <span class="text-white-50 small fw-bold text-uppercase tracking-wider">
          <i class="fa-solid fa-circle-user me-1"></i> Account Details
        </span>
        <a href="/listings" class="btn btn-sm btn-light bg-white bg-opacity-90 border-0 rounded-pill px-3 py-1 fw-bold text-dark shadow-sm">
          <i class="fa-solid fa-arrow-left me-1 text-danger"></i> Explore
        </a>
      </div>

      <div class="px-4 pb-4 text-center">
        <% 
          const hasCustomImage = user.profileImage?.url && !user.profileImage.url.includes("placehold.co");
          const displayName = user.username || (user.email ? user.email.split("@")[0] : "Guest");
          const userInitial = displayName.charAt(0).toUpperCase();
        %>

        <div class="avatar-wrapper">
          <% if (hasCustomImage) { %>
            <img src="<%= user.profileImage.url %>" alt="<%= displayName %>" class="avatar-img">
          <% } else { %>
            <div class="avatar-placeholder" title="<%= displayName %>">
              <%= userInitial %>
            </div>
          <% } %>
          <div class="avatar-badge-check" title="Email Verified">
            <i class="fa-solid fa-check"></i>
          </div>
        </div>

        <h4 class="fw-bold mb-1 text-dark text-capitalize"><%= displayName %></h4>
        <p class="text-muted small mb-3 d-flex align-items-center justify-content-center gap-2">
          <i class="fa-regular fa-envelope text-secondary"></i> <%= user.email %>
        </p>

        <div class="mb-4">
          <span class="guest-badge">
            <i class="fa-solid fa-shield-halved"></i> Verified StayNest Member
          </span>
        </div>

        <div class="profile-stats">
          <div class="profile-stat-item">
            <div class="val text-danger"><%= (user.favorites && user.favorites.length) ? user.favorites.length : 0 %></div>
            <div class="lbl">Wishlisted</div>
          </div>
          <div class="profile-stat-divider"></div>
          <div class="profile-stat-item">
            <div class="val text-success">Active</div>
            <div class="lbl">Status</div>
          </div>
          <div class="profile-stat-divider"></div>
          <div class="profile-stat-item">
            <div class="val text-dark">Member</div>
            <div class="lbl">Role</div>
          </div>
        </div>

        <form action="/profile/update-avatar" method="POST" enctype="multipart/form-data" class="upload-box mb-4 text-start">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="form-label small fw-bold text-dark mb-0">
              <i class="fa-solid fa-camera text-danger me-1"></i> Update Avatar
            </label>
            <span class="text-muted" style="font-size: 0.72rem;">JPG, PNG, WEBP</span>
          </div>
          
          <div class="d-flex flex-column flex-sm-row gap-2 align-items-stretch">
            <input type="file" name="profileImage" class="form-control form-control-sm file-input-clean flex-grow-1" accept="image/*" required>
            <button class="btn btn-staynest-upload" type="submit">
              <i class="fa-solid fa-arrow-up-from-bracket"></i>
              <span>Upload</span>
            </button>
          </div>
        </form>

        <a href="/orders/myorders" class="btn-staynest-bookings w-100">
          <i class="fa-solid fa-bag-shopping"></i>
          <span>View My Bookings & Receipts</span>
        </a>
      </div>
    </div>
  </div>
</div>